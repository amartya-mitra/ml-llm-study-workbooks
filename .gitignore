# Generated, temporary, cached, and environment files only.
# Do NOT add source material, source manifests, figure scripts, or build
# configuration here (AGENTS.md / Stage 2 instructions).

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Quarto / rendering caches (kept out; rendered figures we *do* want to
# keep are committed explicitly under figures/rendered/)
.quarto/
_freeze/
/*_files/

# Rendered PDFs / page images are build products of outputs/ and the
# per-workbook page-images/ folders used by render_and_check.py /
# build_ch01_02_review.py.
outputs/*.pdf
outputs/**/*.pdf.prev-*
outputs/**/*-pages/
workbooks/**/page-images/
workbooks/**/*.pdf
workbooks/**/*.pdf.prev-*

# Portable review bundles (PDF copy + page PNGs + contact sheet +
# extracted text + manifest, packaged as a .tar.gz for human review) --
# these are disposable review artifacts, not source.
outputs/**/review-bundle-*/
outputs/**/review-bundle-*.tar.gz

# Workbook 04 development area: chapter-review PDFs, RC page renders,
# review bundles, and other pre-release build products generated during
# drafting/review. Never committed.
outputs/_development/

# Workbook 04 release archive: historical release-candidate PDFs
# (rc1.pdf ... rc7.pdf), kept for comparison but not the current
# canonical artifact. Only the canonical PDF (outputs/*.pdf, matched
# above) and .gitkeep stay directly under outputs/.
outputs/_releases/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Node (only if mermaid CLI or similar is ever installed locally)
node_modules/

**/*.quarto_ipynb

/.quarto/
